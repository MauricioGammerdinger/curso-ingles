# Copie este arquivo para ".env" e preencha os valores antes de rodar o servidor.

# Porta em que o servidor local vai rodar
PORT=3001

# String de conexão do seu banco Postgres gratuito (Neon, Supabase, etc.)
# Formato: postgresql://usuario:senha@host/nome_do_banco?sslmode=require
# Veja no README como criar uma conta gratuita no Neon e pegar essa URL.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo usado para assinar os tokens de login (JWT).
# IMPORTANTE: gere um valor aleatório e longo, nunca use o exemplo abaixo em produção.
# Pode gerar um bom valor rodando: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_isto_por_um_valor_aleatorio_bem_grande

# Domínio de onde o frontend vai fazer as requisições (em produção).
# Em desenvolvimento local pode deixar "*".
ALLOWED_ORIGIN=*

# Chaves VAPID para notificações push (Web Push). Gere o SEU próprio par rodando:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# A chave pública também é usada pelo frontend — se trocar aqui, troque lá também.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@exemplo.com
